model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  status      Boolean?     @default(false)
  phone       Phone?
  password    String?
  userCourses UserCourse[]
  createdAt   DateTime     @default(now()) @db.Timestamp
  updatedAt   DateTime     @default(now()) @db.Timestamp

  @@map("users")
}
