model Comment {
    id        Int      @id @default(autoincrement())
    name      String
    email     String
    message   String   @db.Text()
    postId    Int
    post      Post     @relation(fields: [postId], references: [id])
    createdAt DateTime @default(now()) @db.Timestamp
    updatedAt DateTime @default(now()) @db.Timestamp

    @@map("comments")
}
