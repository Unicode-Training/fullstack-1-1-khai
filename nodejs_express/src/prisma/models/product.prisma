model Product {
  id          Int            @id @default(autoincrement())
  name        String?        @db.VarChar(255)
  price       Int
  description String?
  status      Boolean
  images      ProductImage[]
  createdAt   DateTime       @default(now()) @db.Timestamp
  updatedAt   DateTime       @default(now()) @db.Timestamp

  @@map("products")
}
